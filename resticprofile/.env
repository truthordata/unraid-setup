DOCUMENTS_FOLDER=/mnt/user/Documents
HOME_ASSISTANT_FOLDER=/mnt/user/misc/home-assistant-backup
NPM_APP_DATA_FOLDER=/mnt/user/appdata/Nginx-Proxy-Manager-Official
FILE_UPLOAD_APP_DATA_FOLDER=/mnt/user/appdata/file-upload