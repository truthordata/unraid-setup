# ResticProfile Paths
APP_DATA_FOLDER=/mnt/user/appdata/resticprofile
SERVER_BACKUP_FOLDER=/mnt/user/backups
SERVER_RESTORE_FOLDER=/mnt/user/restore
RESTIC_PASSWORD_TXT=/mnt/user/secrets/restic_pw.txt
