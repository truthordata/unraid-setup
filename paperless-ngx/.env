# --- Unraid Host Storage Paths ---
VALKEY_DATA_PATH=/mnt/user/appdata/paperless-ngx/valkey
POSTGRES_DATA_PATH=/mnt/user/appdata/paperless-ngx/postgres
PAPERLESS_DATA_PATH=/mnt/user/appdata/paperless-ngx/data

PAPERLESS_MEDIA_PATH=/mnt/user/Documents/paperless-ngx/media
PAPERLESS_EXPORT_PATH=/mnt/user/Documents/paperless-ngx/export
PAPERLESS_CONSUME_PATH=/mnt/user/Documents/paperless-ngx/consume

# --- Database Configurations ---
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless

# --- Network and System Settings ---
WEBSERVER_PORT=8000
USERMAP_UID=99
USERMAP_GID=100

# --- Optional Paperless Settings ---
PAPERLESS_TIME_ZONE=America/New_York
PAPERLESS_OCR_LANGUAGE=eng

SECRETS_DOTENV=/mnt/user/secrets/paperless.env
